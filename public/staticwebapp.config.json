{
  "routes": [
    { "route": "/3d", "rewrite": "/3d.html" },
    { "route": "/api/*", "headers": { "Cache-Control": "no-store" } }
  ],
  "platform": { "apiRuntime": "node:22" },
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*", "/api/*"] },
  "mimeTypes": { ".js": "application/javascript" }
}
